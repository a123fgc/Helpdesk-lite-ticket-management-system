# ===========================================================================
# HelpDesk Lite — backend environment
#
# Copy to `backend/.env` and fill in real values:
#     cp backend/.env.example backend/.env
#
# NEVER commit a real `.env`. It is git-ignored at the repo root, in backend/
# and in frontend/. This file contains placeholders only.
#
# Every variable below is read by backend/src/config/env.js.
# ===========================================================================

# ── Runtime ────────────────────────────────────────────────────────────────
# HTTP port the Express server listens on.
PORT=5000

# development | test | production.
# `production` additionally blocks the destructive seed script.
NODE_ENV=development

# error | warn | info | debug
LOG_LEVEL=info

# Set ONLY when running behind a reverse proxy (Render, Railway, nginx, ...).
# Number of proxy hops in front of the app; required for express-rate-limit
# to see the real client IP. Leave unset when directly exposed.
# TRUST_PROXY=1


# ── Database ───────────────────────────────────────────────────────────────
# PostgreSQL connection string. Required.
#   local:    postgres://user:password@localhost:5432/helpdesk
#   hosted:   postgres://user:password@host/db?sslmode=require
DATABASE_URL=postgres://user:password@localhost:5432/helpdesk

# Dedicated database used ONLY by the integration test suite.
# Leave unset to skip integration tests (unit tests still run).
# TEST_DATABASE_URL=postgres://user:password@localhost:5432/helpdesk_test


# ── Authentication ─────────────────────────────────────────────────────────
# Signs and verifies JWTs. REQUIRED.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every existing session (users must log in again).
JWT_SECRET=

# Lifetime of an access token.
JWT_EXPIRES_IN=7d


# ── Webhooks ───────────────────────────────────────────────────────────────
# Shared secret used to compute the X-Signature HMAC-SHA256 header.
# REQUIRED even when no webhook URL is configured.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating it makes receivers reject in-flight signatures until they update.
WEBHOOK_SECRET=

# Make.com custom-webhook authentication. If the Make "Webhooks" module is
# configured with an API key, paste the SAME value here: it is sent as the
# `x-make-apikey` header on every delivery. A missing/wrong value is the usual
# cause of HTTP 401 from Make.com. Leave blank only if Make requires no key.
MAKE_WEBHOOK_API_KEY=

# Outbound webhook targets — one per supported event.
# LEAVE BLANK to disable that event. A blank value is reported explicitly in
# the logs ("webhook NOT queued ... Set WEBHOOK_URL_..."), never silently.
# All four events: ticket.created, ticket.status_changed, ticket.resolved,
# ticket.sla_breach.
WEBHOOK_URL_TICKET_CREATED=
WEBHOOK_URL_STATUS_CHANGED=
WEBHOOK_URL_TICKET_RESOLVED=
WEBHOOK_URL_SLA_BREACH=

# Retry policy for failed deliveries: exponential backoff
# base * 2^(attempt-1), capped at 6 hours, up to MAX_RETRIES attempts.
WEBHOOK_MAX_RETRIES=5
WEBHOOK_BASE_DELAY_MS=60000

# How often the retry worker scans for due deliveries (node-cron syntax).
WEBHOOK_RETRY_CRON=* * * * *

# Repeated identical events within this many milliseconds collapse into one
# queue row (idempotency), e.g. duplicate/no-op status-change clicks.
WEBHOOK_IDEMPOTENCY_WINDOW_MS=60000

# A delivery lease (seconds) prevents cron overlaps and manual resend from
# sending the same event at the same time. Keep it above the HTTP timeout (10s).
WEBHOOK_CLAIM_LEASE_SECONDS=60

# Max rows claimed per retry tick.
WEBHOOK_BATCH_SIZE=20

# Note: after pasting NEW Make.com URLs above, restart the backend. Existing
# queued/failed events are automatically switched to the current URL on their
# next attempt; no manual database edit is needed.


# ── File uploads ───────────────────────────────────────────────────────────
# Directory for uploaded attachments, relative to the backend working
# directory. Git-ignored; the folder must be writable by the server process.
UPLOAD_DIR=uploads

# Per-file size limit in megabytes (max 2 files per ticket).
MAX_FILE_SIZE_MB=5


# ── CORS ───────────────────────────────────────────────────────────────────
# Exact origin of the React app. Must match the browser's origin exactly,
# including scheme and port.
CLIENT_ORIGIN=http://localhost:5173


# ── Scheduled jobs ─────────────────────────────────────────────────────────
# Auto-close resolved tickets after N days without a customer reply.
AUTO_CLOSE_DAYS=3

# SLA breach scan + auto-close schedule (node-cron syntax).
SLA_CHECK_CRON=*/5 * * * *

# Sweep for expired idempotency keys (node-cron syntax).
# Only rows older than IDEMPOTENCY_TTL_HOURS are removed, so keys belonging
# to in-flight requests are never deleted.
IDEMPOTENCY_CLEANUP_CRON=17 4 * * *
IDEMPOTENCY_TTL_HOURS=24


# ── Shutdown ───────────────────────────────────────────────────────────────
# Milliseconds to drain in-flight requests after SIGTERM/SIGINT before the
# process is forced to exit.
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Frontend environment (all values are VITE_-prefixed and therefore PUBLIC:
# they are compiled into the browser bundle. Never put secrets here.)
# ---------------------------------------------------------------------------

# Base URL the browser uses to reach the backend API.
#
#   Development (default) : leave as "/api". The Vite dev server proxies
#                           /api to VITE_PROXY_TARGET, so the browser only
#                           ever talks to http://localhost:5173.
#
#   Production, same host : leave as "/api" and have your reverse proxy
#                           (nginx / Caddy / Render / Cloudflare) forward
#                           /api to the Express server.
#
#   Production, other host: absolute URL, e.g.
#                           VITE_API_BASE_URL=https://helpdesk-api.example.com/api
#                           Also set CLIENT_ORIGIN on the backend to this
#                           site's origin so CORS allows the browser.
VITE_API_URL=helpdesk-lite-ticket-management-system-production.up.railway.app

# DEV ONLY — target of the Vite dev-server proxy for /api.
# Ignored entirely by `npm run build` / production deployments.
